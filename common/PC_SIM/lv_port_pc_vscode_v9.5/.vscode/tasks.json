        //     "args": ["fullclean"],
        //     "options": {
        //         "cwd": "${workspaceFolder}"
        //     }
        // },
        {
            "label": "Clean Debug",
            "type": "process",
            "command": "build.bat",
            "args": ["clean_dbg"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clean Release",
            "type": "process",
            "command": "build.bat",
            "args": ["clean_rel"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Full Clean Debug",
            "type": "process",
            "command": "build.bat",
            "args": ["fullclean_dbg"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Full Clean Release",
            "type": "process",
            "command": "build.bat",
            "args": ["fullclean_rel"],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
